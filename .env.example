# Local development only. Replace all placeholders before non-local deployment.
POSTGRES_USER=automiq
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=automiq
DATABASE_URL=postgresql+asyncpg://automiq:local-only-change-me@postgres:5432/automiq
REDIS_URL=redis://redis:6379/0
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=automiq-bootstrap
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
SESSION_SECRET=local-only-replace-before-auth
ENCRYPTION_KEY_REF=local-only-placeholder
# Base64-encoded 32 random bytes. Required when creating or using integrations.
# Generate locally; keep the resulting value only in ignored .env or a secret manager.
INTEGRATION_ENCRYPTION_KEY=
# Optional master-key rotation: JSON map of version to base64 key, kept in a secret manager.
# When set, it replaces INTEGRATION_ENCRYPTION_KEY. Retain old versions until rows are rewrapped.
INTEGRATION_KEYRING=
INTEGRATION_ACTIVE_KEY_VERSION=1
INTEGRATION_PROVIDER_MODE=fake
# Agent nodes use this operator-selected provider. Real calls require explicit rates
# (USD per million tokens) so the cost budget can be enforced in micro USD.
LLM_PROVIDER_MODE=fake
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENV=development
# Set all three OIDC settings for non-local sign-in. The issuer must use HTTPS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
# Opt-in single-destination HTTPS GET. The graph can only provide a relative path.
HTTP_CONNECTOR_ENABLED=false
HTTP_CONNECTOR_ORIGIN=
