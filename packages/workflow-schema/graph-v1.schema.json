            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "ScheduleNode",
      "type": "object"
    },
    "SlackMessageConfig": {
      "additionalProperties": false,
      "properties": {
        "integration_id": {
          "format": "uuid",
          "title": "Integration Id",
          "type": "string"
        },
        "channel": {
          "pattern": "^[#A-Za-z0-9_-]{1,80}$",
          "title": "Channel",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "integration_id",
        "channel",
        "text"
      ],
