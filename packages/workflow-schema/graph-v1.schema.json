      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "GithubIssueNode",
      "type": "object"
    },
    "HttpConfig": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "default": "mock",
          "enum": [
            "mock",
            "https_get"
          ],
          "title": "Operation",
          "type": "string"
        },
        "mock_output": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Mock Output",
          "type": "object"
        },
        "failures_before_success": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Failures Before Success",
          "type": "integer"
        },
        "permanent_failure": {
          "default": false,
          "title": "Permanent Failure",
          "type": "boolean"
        },
        "delay_seconds": {
          "default": 0,
          "maximum": 6,
          "minimum": 0,
          "title": "Delay Seconds",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "response_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Response Fields",
          "type": "array"
        }
      },
      "title": "HttpConfig",
      "type": "object"
    },
    "HttpNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "action.http",
          "title": "Type",
          "type": "string"
