{
  "$defs": {
    "AgentConfig": {
      "additionalProperties": false,
      "properties": {
        "model_profile": {
          "default": "fake",
          "enum": [
            "fake",
            "openai"
          ],
          "title": "Model Profile",
          "type": "string"
        },
        "instructions": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "allowed_tools": {
          "items": {
            "const": "github.search_issues",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Allowed Tools",
          "type": "array"
        },
        "github_integration_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Integration Id"
        },
        "input_schema": {
          "$ref": "#/$defs/AgentSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/AgentSchema"
        },
        "max_tool_calls": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_duration_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_input_tokens": {
          "default": 2000,
          "maximum": 8000,
          "minimum": 100,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 300,
          "maximum": 2000,
          "minimum": 30,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_cost_microusd": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Max Cost Microusd",
          "type": "integer"
        }
      },
      "required": [
        "instructions"
      ],
      "title": "AgentConfig",
      "type": "object"
    },
    "AgentNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "agent",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/AgentConfig"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "AgentNode",
      "type": "object"
    },
    "AgentSchema": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object",
          "default": "object",
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean"
            ],
            "type": "string"
          },
          "maxProperties": 12,
          "title": "Properties"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Required",
          "type": "array"
        }
      },
      "title": "AgentSchema",
      "type": "object"
    },
    "ApprovalConfig": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 3600,
          "maximum": 604800,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "title"
      ],
      "title": "ApprovalConfig",
      "type": "object"
    },
    "ApprovalNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "approval",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/ApprovalConfig"
        },
        "position": {
          "anyOf": [
