            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "ApprovalNode",
      "type": "object"
    },
    "ConditionConfig": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "expression"
      ],
      "title": "ConditionConfig",
      "type": "object"
    },
    "ConditionNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "condition",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/ConditionConfig"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "ConditionNode",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "source_handle": {
          "anyOf": [
            {
              "enum": [
                "true",
                "false"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Handle"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EndConfig": {
      "additionalProperties": false,
      "properties": {},
      "title": "EndConfig",
      "type": "object"
    },
    "EndNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "end",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/EndConfig"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "EndNode",
      "type": "object"
    },
    "Expression": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "exists"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "path",
        "operator"
      ],
      "title": "Expression",
      "type": "object"
    },
    "GithubCommentConfig": {
      "additionalProperties": false,
      "properties": {
        "integration_id": {
          "format": "uuid",
          "title": "Integration Id",
          "type": "string"
        },
        "body": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "integration_id",
        "body"
      ],
      "title": "GithubCommentConfig",
      "type": "object"
    },
    "GithubCommentNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "action.github_comment",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GithubCommentConfig"
