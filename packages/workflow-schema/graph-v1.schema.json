  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "action.github_comment": "#/$defs/GithubCommentNode",
            "action.http": "#/$defs/HttpNode",
            "action.slack_message": "#/$defs/SlackMessageNode",
            "agent": "#/$defs/AgentNode",
            "approval": "#/$defs/ApprovalNode",
            "condition": "#/$defs/ConditionNode",
            "end": "#/$defs/EndNode",
            "trigger.github_issue": "#/$defs/GithubIssueNode",
            "trigger.manual": "#/$defs/ManualNode",
            "trigger.schedule": "#/$defs/ScheduleNode"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ManualNode"
          },
          {
            "$ref": "#/$defs/GithubIssueNode"
          },
          {
            "$ref": "#/$defs/ScheduleNode"
          },
          {
            "$ref": "#/$defs/HttpNode"
          },
          {
            "$ref": "#/$defs/GithubCommentNode"
          },
          {
            "$ref": "#/$defs/SlackMessageNode"
          },
          {
            "$ref": "#/$defs/AgentNode"
          },
          {
            "$ref": "#/$defs/ApprovalNode"
          },
          {
            "$ref": "#/$defs/ConditionNode"
          },
          {
            "$ref": "#/$defs/EndNode"
          }
        ]
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "maxItems": 150,
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "nodes",
    "edges"
  ],
  "title": "Graph",
  "type": "object"
}
