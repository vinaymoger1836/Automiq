        }
      },
      "required": [
        "id",
        "type",
        "config"
      ],
      "title": "ManualNode",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 10000,
          "minimum": -10000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
