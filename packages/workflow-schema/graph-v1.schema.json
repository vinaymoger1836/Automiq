    },
    "ManualNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "trigger.manual",
          "title": "Type",
          "type": "string"
        },
        "config": {
