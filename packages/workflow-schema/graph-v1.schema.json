    "GithubIssueNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "trigger.github_issue",
          "title": "Type",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/GithubIssueConfig"
